spring.application.name=chatbot

# Google Gemini — primary provider
spring.ai.google.genai.api-key=YOUR_GEMINI_KEY_HERE
spring.ai.google.genai.chat.options.model=gemini-3.8-flash

# OpenRouter — secondary provider
spring.ai.openai.api-key=YOUR_OPENROUTER_KEY_HERE
spring.ai.openai.base-url=https://openrouter.ai/api/v1
spring.ai.openai.chat.options.model=nvidia/nemotron-3.5-lightning:free



# Ollama — local fallback
spring.ai.ollama.base-url=http://localhost:11434
spring.ai.ollama.chat.options.model=llama3.2


# Disable problem details
spring.mvc.problemdetails.enabled=false

# Token optimization
chatbot.memory.max-messages=10

# Chroma vector store
spring.ai.vectorstore.chroma.client.host=http://localhost
spring.ai.vectorstore.chroma.client.port=
spring.ai.vectorstore.chroma.collection-name=
spring.ai.vectorstore.chroma.initialize-schema=true

spring.ai.model.embedding=ollama
spring.ai.ollama.embedding.model=nomic-embed-text

#redis configuration
spring.data.redis.host=localhost
spring.data.redis.port=6380
spring.cache.type=redis

# PostgreSQL
spring.datasource.url=jdbc:postgresql://localhost:5432/chatbotdb?TimeZone=UTC
spring.datasource.username=
spring.datasource.password=
spring.datasource.driver-class-name=org.postgresql.Driver


# Spring Data JPA configuration
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.open-in-view=false

management.endpoints.web.exposure.include=health
management.endpoint.health.show-details=never

server.tomcat.connection-timeout=60s
spring.mvc.async.request-timeout=60000g